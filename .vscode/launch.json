{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chaos Agents: LLM mode, 3 rounds, obs, voice",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["--no-placeholder", "--rounds", "3", "--obs", "--voice"]
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}
